<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ugv">
  <!-- Differential 4-wheel UGV. Metres, kilograms. Frames follow REP-103 (x forward, z up). -->
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_ros2_control" default="false"/>
  <xacro:arg name="sim" default="false"/>
  <xacro:arg name="ns" default="v1"/>
  <xacro:arg name="controllers_yaml" default=""/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <xacro:property name="body_l" value="1.20"/>
  <xacro:property name="body_w" value="0.70"/>
  <xacro:property name="body_h" value="0.35"/>
  <xacro:property name="body_m" value="60.0"/>
  <xacro:property name="wheel_r" value="0.20"/>
  <xacro:property name="wheel_w" value="0.10"/>
  <xacro:property name="wheel_m" value="4.0"/>
  <xacro:property name="wheel_x" value="0.40"/>
  <xacro:property name="wheel_y" value="${body_w/2 + wheel_w/2}"/>
  <xacro:property name="ground_clearance" value="0.12"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
  </xacro:macro>
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" iyy="${m*(3*r*r+h*h)/12}" izz="${m*r*r/2}" ixy="0" ixz="0" iyz="0"/>
  </xacro:macro>

  <link name="${prefix}base_footprint"/>
  <joint name="${prefix}base_footprint_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 ${ground_clearance + body_h/2}"/>
  </joint>

  <link name="${prefix}base_link">
    <visual>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="olive"><color rgba="0.35 0.40 0.20 1"/></material>
    </visual>
    <collision><geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry></collision>
    <inertial><mass value="${body_m}"/><xacro:box_inertia m="${body_m}" x="${body_l}" y="${body_w}" z="${body_h}"/></inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${prefix}${name}_wheel">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial><mass value="${wheel_m}"/><xacro:cylinder_inertia m="${wheel_m}" r="${wheel_r}" h="${wheel_w}"/></inertial>
    </link>
    <joint name="${prefix}${name}_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${name}_wheel"/>
      <origin xyz="${x} ${y} ${-(ground_clearance + body_h/2 - wheel_r)}"/>
      <axis xyz="0 1 0"/>
      <limit effort="40" velocity="30"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="front_left"  x="${wheel_x}"  y="${wheel_y}"/>
  <xacro:wheel name="front_right" x="${wheel_x}"  y="${-wheel_y}"/>
  <xacro:wheel name="rear_left"   x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="rear_right"  x="${-wheel_x}" y="${-wheel_y}"/>

  <!-- Sensor mounts. Gazebo sensor plugins attach to these links in corridor_gz. -->
  <xacro:macro name="mount" params="name xyz rpy:='0 0 0' size:='0.08 0.08 0.06'">
    <link name="${prefix}${name}_link">
      <visual><geometry><box size="${size}"/></geometry><material name="grey"><color rgba="0.6 0.6 0.6 1"/></material></visual>
      <inertial><mass value="0.2"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="${prefix}${name}_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>
  <xacro:mount name="lidar"  xyz="0.30 0 ${body_h/2 + 0.10}" size="0.10 0.10 0.08"/>
  <xacro:mount name="camera" xyz="${body_l/2 - 0.02} 0 ${body_h/2 - 0.05}"/>
  <xacro:mount name="imu"    xyz="0 0 0" size="0.03 0.03 0.01"/>
  <xacro:mount name="gnss"   xyz="-0.40 0 ${body_h/2 + 0.05}" size="0.06 0.06 0.02"/>

  <xacro:if value="$(arg sim)">
    <xacro:include filename="$(find corridor_description)/urdf/ugv.gazebo.xacro"/>
    <xacro:ugv_gazebo prefix="${prefix}" ns="$(arg ns)"/>
  </xacro:if>

  <xacro:if value="$(arg use_ros2_control)">
    <ros2_control name="${prefix}ugv_system" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <xacro:macro name="wheel_if" params="name">
        <joint name="${prefix}${name}_wheel_joint">
          <command_interface name="velocity"><param name="min">-30</param><param name="max">30</param></command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>
      <xacro:wheel_if name="front_left"/>
      <xacro:wheel_if name="front_right"/>
      <xacro:wheel_if name="rear_left"/>
      <xacro:wheel_if name="rear_right"/>
    </ros2_control>
  </xacro:if>
</robot>
