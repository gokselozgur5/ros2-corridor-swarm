<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>corridor_sim</name>
  <version>0.1.0</version>
  <description>Simulated vehicles patrolling a mission corridor, for Foxglove and ATAK.</description>
  <maintainer email="gokselozgur@novit.ai">Göksel Özgür</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
