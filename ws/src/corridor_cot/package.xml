<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>corridor_cot</name>
  <version>0.1.0</version>
  <description>Cursor-on-Target bridge: vehicle fixes to a TAK server as PLI events, TAK markers back as mission requests.</description>
  <maintainer email="gokselozgur@novit.ai">Göksel Özgür</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
